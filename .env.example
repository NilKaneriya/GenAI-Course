# Copy to .env to connect the mentor to a real AI model. .env is git-ignored.
# Leave AI_PROVIDER empty to use the simulated mentor (no key needed).
PORT=5173

# AI_PROVIDER=anthropic
# AI_API_KEY=your-key-here
# AI_MODEL=claude-sonnet-5-5

# Or any provider exposing an OpenAI-compatible /chat/completions endpoint:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=your-key-here
# AI_MODEL=your-model-id
